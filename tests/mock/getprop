#!/usr/bin/env python3
"""Mock of Android's getprop for tests: reads tests/fixtures/getprop.txt."""
import os, sys
FX = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "fixtures")
props = {}
path = os.path.join(FX, "getprop.txt")
if os.path.exists(path):
    for line in open(path, encoding="utf-8", errors="replace"):
        line = line.strip()
        if line.startswith("[") and "]: [" in line:
            k, v = line[1:].split("]: [", 1)
            props[k] = v.rstrip("]")
if len(sys.argv) > 1:
    print(props.get(sys.argv[1], ""))
else:
    for k in sorted(props):
        print("[%s]: [%s]" % (k, props[k]))
